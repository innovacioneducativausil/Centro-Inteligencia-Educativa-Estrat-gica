  fecha_creacion       DateTime    @default(now()) @db.Timestamp(0)
  fecha_actualizacion  DateTime    @default(now()) @db.Timestamp(0)
  escenario            escenario[]
  senal                senal[]
  tendencia            tendencia[]

  @@index([activo], map: "idx_estado_activo")
  @@index([es_visible_publico], map: "idx_estado_visible")
}

model informe_empleabilidad {
  id             Int                                @id @default(autoincrement())
  nombre         String                             @db.VarChar(255)
  anio           Int
  unidad         String                             @db.VarChar(100)
