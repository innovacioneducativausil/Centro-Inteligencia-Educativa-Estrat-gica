generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma/radar"
}

datasource db {
  provider = "mysql"
  url      = env("RADAR_DATABASE_URL")
}

model actividad_usuario {
  id              Int      @id @default(autoincrement()) @db.UnsignedInt
  id_usuario      String?  @db.VarChar(36)
  correo          String?  @db.VarChar(255)
  rol             String?  @db.VarChar(50)
  evento          String   @db.VarChar(100)
  accion          String?  @db.VarChar(100)
  modulo          String?  @db.VarChar(100)
  entidad         String?  @db.VarChar(100)
  entidad_id      String?  @db.VarChar(100)
  elemento_uuid   String?  @db.VarChar(36)
  elemento_tipo   String?  @db.VarChar(50)
  elemento_titulo String?  @db.VarChar(500)
  detalle         String?  @db.Text
  ip              String?  @db.VarChar(45)
  user_agent      String?  @db.Text
  metadata        Json?
  fecha_hora      DateTime @default(now()) @db.DateTime(0)

  @@index([correo], map: "idx_correo")
  @@index([evento], map: "idx_evento")
  @@index([fecha_hora], map: "idx_fecha")
}

model alerta_generada {
  id_alerta           BigInt    @id @default(autoincrement())
  id_regla            String    @db.VarChar(36)
  metrica             String    @db.VarChar(50)
  valor_medido        Decimal   @db.Decimal(12, 2)
  valor_umbral        Decimal   @db.Decimal(12, 2)
  mensaje             String    @db.VarChar(500)
  fecha_generada      DateTime  @default(now()) @db.DateTime(0)
  atendida            Boolean   @default(false)
  atendida_por        String?   @db.VarChar(36)
  fecha_atendida      DateTime? @db.DateTime(0)
  elementos_afectados Json?

  @@index([atendida], map: "idx_atendida")
  @@index([id_regla], map: "idx_regla")
}

model alerta_metrica_historial {
  id_historial   BigInt   @id @default(autoincrement())
  metrica        String   @db.VarChar(50)
  valor          Decimal  @db.Decimal(12, 2)
  fecha_medicion DateTime @default(now()) @db.DateTime(0)

  @@index([metrica, fecha_medicion], map: "idx_metrica_fecha")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model escenario {
  id_escenario                                       String                @id @db.Char(36)
  titulo_escenario                                   String                @db.VarChar(180)
  nombre_escenario                                   String                @unique(map: "nombre_escenario") @db.VarChar(100)
  desc_corta_escenario                               String                @db.Text
  desc_larga_escenario                               String                @db.Text
  razon_cambio                                       String?               @db.Text
  url_video_escenario                                String?               @db.VarChar(500)
  url_imagen_escenario                               String?               @db.VarChar(500)
  fuente_escenario                                   String?               @db.VarChar(300)
  url_fuente                                         String?               @db.Text
  id_estado                                          Int                   @default(1)
  id_usuario_creador                                 String                @db.Char(36)
  id_usuario_actualizador                            String?               @db.Char(36)
  fecha_publicacion                                  DateTime?             @db.Timestamp(0)
  fecha_creacion                                     DateTime              @default(now()) @db.Timestamp(0)
  fecha_actualizacion                                DateTime              @default(now()) @db.Timestamp(0)
  horizonte_escenario                                String?               @db.VarChar(20)
  probabilidad                                       Int?                  @db.TinyInt
  id_topico                                          Int?
  fecha_archivado                                    DateTime?             @db.DateTime(0)
  autor                                              String?               @db.VarChar(160)
  referencias_escenario                              String?               @db.Text
  estado                                             estado                @relation(fields: [id_estado], references: [id_estado], onUpdate: NoAction, map: "escenario_ibfk_1")
  usuario_escenario_id_usuario_creadorTousuario      usuario               @relation("escenario_id_usuario_creadorTousuario", fields: [id_usuario_creador], references: [id_usuario], onUpdate: NoAction, map: "escenario_ibfk_2")
  usuario_escenario_id_usuario_actualizadorTousuario usuario?              @relation("escenario_id_usuario_actualizadorTousuario", fields: [id_usuario_actualizador], references: [id_usuario], onUpdate: NoAction, map: "escenario_ibfk_3")
  topico                                             topico?               @relation(fields: [id_topico], references: [id_topico], onUpdate: NoAction, map: "escenario_ibfk_4")
  escenario_pestel                                   escenario_pestel[]
  escenario_sector                                   escenario_sector[]
  escenario_senal                                    escenario_senal[]
  escenario_tendencia                                escenario_tendencia[]
  senal_escenario                                    senal_escenario[]
  tendencia_escenario                                tendencia_escenario[]

  @@index([id_topico], map: "id_topico")
  @@index([id_usuario_actualizador], map: "id_usuario_actualizador")
  @@index([id_usuario_creador], map: "idx_escenario_creador")
  @@index([id_estado], map: "idx_escenario_estado")
  @@index([fecha_publicacion], map: "idx_escenario_fecha_pub")
  @@index([nombre_escenario], map: "idx_escenario_nombre")
}

model escenario_pestel {
  id_escenario String    @db.Char(36)
  id_pestel    Int
  escenario    escenario @relation(fields: [id_escenario], references: [id_escenario], onDelete: Cascade, onUpdate: NoAction, map: "escenario_pestel_ibfk_1")
  pestel       pestel    @relation(fields: [id_pestel], references: [id_pestel], onDelete: Cascade, onUpdate: NoAction, map: "escenario_pestel_ibfk_2")

  @@id([id_escenario, id_pestel])
  @@index([id_pestel], map: "idx_escenario_pestel_pestel")
}

model escenario_sector {
  id_escenario String    @db.Char(36)
  id_sector    String    @db.VarChar(5)
  escenario    escenario @relation(fields: [id_escenario], references: [id_escenario], onDelete: Cascade, onUpdate: NoAction, map: "escenario_sector_ibfk_1")
  sector       sector    @relation(fields: [id_sector], references: [id_sector], onDelete: Cascade, onUpdate: NoAction, map: "escenario_sector_ibfk_2")

  @@id([id_escenario, id_sector])
  @@index([id_sector], map: "idx_escenario_sector_sector")
}

model escenario_senal {
  id_escenario String    @db.Char(36)
