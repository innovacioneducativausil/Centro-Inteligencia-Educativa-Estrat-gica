  @@index([id_senal], map: "idx_escenario_senal_senal")
}

model escenario_tendencia {
  id_escenario String    @db.Char(36)
  id_tendencia String    @db.Char(36)
  escenario    escenario @relation(fields: [id_escenario], references: [id_escenario], onDelete: Cascade, onUpdate: NoAction, map: "escenario_tendencia_ibfk_1")
  tendencia    tendencia @relation(fields: [id_tendencia], references: [id_tendencia], onDelete: Cascade, onUpdate: NoAction, map: "escenario_tendencia_ibfk_2")

