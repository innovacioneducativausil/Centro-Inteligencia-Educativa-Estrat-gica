model estado {
  id_estado            Int         @id @default(autoincrement())
  nombre_estado        String      @unique(map: "nombre_estado") @db.VarChar(50)
  slug_estado          String      @unique(map: "slug_estado") @db.VarChar(50)
  desc_estado          String?     @db.Text
  es_visible_publico   Boolean     @default(false)
  es_editable          Boolean     @default(true)
  permite_transicion_a String?     @db.VarChar(200)
  color                String      @db.VarChar(7)
  icono                String?     @db.VarChar(10)
