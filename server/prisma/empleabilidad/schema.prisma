generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma/empleabilidad"
}

datasource db {
  provider = "mysql"
  url      = env("EMPLEABILIDAD_DATABASE_URL")
}

model benchmark_parse_log {
  id_parse_log              Int                        @id @default(autoincrement()) @db.UnsignedInt
  id_programa_benchmark     Int                        @db.UnsignedInt
  id_snapshot               Int?                       @db.UnsignedInt
  parser_usado              String                     @db.VarChar(80)
  estado                    benchmark_parse_log_estado @default(ok)
  cursos_detectados         Int                        @default(0) @db.UnsignedInt
  detalle                   String?                    @db.Text
  created_at                DateTime?                  @default(now()) @db.Timestamp(0)
  programa_benchmark        programa_benchmark         @relation(fields: [id_programa_benchmark], references: [id_programa_benchmark], onDelete: Cascade, onUpdate: NoAction, map: "fk_bpl_programa")
  benchmark_source_snapshot benchmark_source_snapshot? @relation(fields: [id_snapshot], references: [id_snapshot], onUpdate: NoAction, map: "fk_bpl_snapshot")

  @@index([id_programa_benchmark], map: "idx_bpl_programa")
  @@index([id_snapshot], map: "idx_bpl_snapshot")
}

model benchmark_program_equivalence {
  id_equivalence          Int                                              @id @default(autoincrement()) @db.UnsignedInt
  id_programa_benchmark   Int                                              @unique(map: "uk_equivalence_programa") @db.UnsignedInt
  nombre_oficial_sugerido String?                                          @db.VarChar(300)
  aliases_json            Json?
  nivel_equivalencia      benchmark_program_equivalence_nivel_equivalencia @default(cercana)
  observaciones           String?                                          @db.Text
  created_at              DateTime?                                        @default(now()) @db.Timestamp(0)
  updated_at              DateTime?                                        @default(now()) @db.Timestamp(0)
  programa_benchmark      programa_benchmark                               @relation(fields: [id_programa_benchmark], references: [id_programa_benchmark], onDelete: Cascade, onUpdate: NoAction, map: "fk_equivalence_programa")
}

model benchmark_source {
  id_benchmark_source       Int                          @id @default(autoincrement()) @db.UnsignedInt
  id_programa_benchmark     Int                          @db.UnsignedInt
  tipo_fuente               benchmark_source_tipo_fuente @default(pagina_programa)
  titulo                    String                       @db.VarChar(300)
  url                       String                       @db.VarChar(1200)
  estado                    benchmark_source_estado      @default(registrado)
  es_fuente_principal       Boolean                      @default(false)
  fecha_captura             DateTime?                    @db.DateTime(0)
  fecha_validacion          DateTime?                    @db.DateTime(0)
  validado_por              String?                      @db.VarChar(160)
  extractor                 String?                      @db.VarChar(80)
  extractor_version         String?                      @db.VarChar(40)
  evidencia_resumen         String?                      @db.Text
  observaciones             String?                      @db.Text
  snapshot_hash             String?                      @db.VarChar(128)
  activo                    Boolean                      @default(true)
  created_at                DateTime?                    @default(now()) @db.Timestamp(0)
  updated_at                DateTime?                    @default(now()) @db.Timestamp(0)
  programa_benchmark        programa_benchmark           @relation(fields: [id_programa_benchmark], references: [id_programa_benchmark], onDelete: Cascade, onUpdate: NoAction, map: "fk_bs_programa")
  benchmark_source_snapshot benchmark_source_snapshot[]

  @@unique([id_programa_benchmark, url(length: 255)], map: "uk_benchmark_source_url")
  @@index([estado], map: "idx_bs_estado")
  @@index([id_programa_benchmark], map: "idx_bs_programa")
  @@index([tipo_fuente], map: "idx_bs_tipo")
}

model benchmark_source_candidate {
  id_candidate          Int                                              @id @default(autoincrement()) @db.UnsignedInt
  id_programa_benchmark Int                                              @db.UnsignedInt
  url                   String                                           @db.VarChar(1200)
  titulo                String?                                          @db.VarChar(400)
  snippet               String?                                          @db.Text
  tipo_fuente_detectado benchmark_source_candidate_tipo_fuente_detectado @default(otra)
  score_total           Decimal                                          @default(0.00) @db.Decimal(6, 2)
  score_detalle_json    Json?
  estado                benchmark_source_candidate_estado                @default(candidato)
  motivo                String?                                          @db.Text
  buscado_en            DateTime                                         @default(now()) @db.DateTime(0)
  revisado_en           DateTime?                                        @db.DateTime(0)
  revisado_por          String?                                          @db.VarChar(160)
  created_at            DateTime?                                        @default(now()) @db.Timestamp(0)
  updated_at            DateTime?                                        @default(now()) @db.Timestamp(0)
  programa_benchmark    programa_benchmark                               @relation(fields: [id_programa_benchmark], references: [id_programa_benchmark], onDelete: Cascade, onUpdate: NoAction, map: "fk_candidate_programa")

  @@unique([id_programa_benchmark, url(length: 255)], map: "uk_candidate_program_url")
  @@index([estado], map: "idx_candidate_estado")
  @@index([id_programa_benchmark], map: "idx_candidate_programa")
  @@index([score_total], map: "idx_candidate_score")
}

model benchmark_source_snapshot {
  id_snapshot           Int                                     @id @default(autoincrement()) @db.UnsignedInt
  id_benchmark_source   Int?                                    @db.UnsignedInt
  id_programa_benchmark Int                                     @db.UnsignedInt
  url                   String                                  @db.VarChar(1200)
  url_final             String?                                 @db.VarChar(1200)
  titulo                String?                                 @db.VarChar(500)
  texto_extraido        String?                                 @db.MediumText
  hash_contenido        String                                  @db.VarChar(128)
  parser_usado          String?                                 @db.VarChar(80)
  estado_parseo         benchmark_source_snapshot_estado_parseo @default(sin_parsear)
  cursos_detectados     Int                                     @default(0) @db.UnsignedInt
  observaciones         String?                                 @db.Text
  fecha_captura         DateTime                                @default(now()) @db.DateTime(0)
  created_at            DateTime?                               @default(now()) @db.Timestamp(0)
  benchmark_parse_log   benchmark_parse_log[]
  benchmark_source      benchmark_source?                       @relation(fields: [id_benchmark_source], references: [id_benchmark_source], onUpdate: NoAction, map: "fk_bss_fuente")
  programa_benchmark    programa_benchmark                      @relation(fields: [id_programa_benchmark], references: [id_programa_benchmark], onDelete: Cascade, onUpdate: NoAction, map: "fk_bss_programa")

  @@index([id_benchmark_source], map: "idx_bss_fuente")
  @@index([hash_contenido], map: "idx_bss_hash")
  @@index([id_programa_benchmark], map: "idx_bss_programa")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model carrera {
  id_carrera       Int           @id @default(autoincrement()) @db.UnsignedInt
  nombre_carrera   String        @db.VarChar(200)
  id_facultad      Int           @db.UnsignedInt
  id_tipo_programa Int           @db.UnsignedInt
  created_at       DateTime?     @default(now()) @db.Timestamp(0)
  facultad         facultad      @relation(fields: [id_facultad], references: [id_facultad], onDelete: NoAction, onUpdate: NoAction, map: "fk_carrera_facultad")
  tipo_programa    tipo_programa @relation(fields: [id_tipo_programa], references: [id_tipo_programa], onDelete: NoAction, onUpdate: NoAction, map: "fk_carrera_tipo_programa")
  egresado         egresado[]

  @@unique([nombre_carrera, id_tipo_programa], map: "uq_carrera")
  @@index([id_facultad], map: "fk_carrera_facultad")
  @@index([id_tipo_programa], map: "fk_carrera_tipo_programa")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model catalogo_puesto {
  id_puesto      Int      @id @default(autoincrement()) @db.UnsignedInt
  texto_busqueda String   @unique(map: "uq_texto_busqueda") @db.VarChar(200)
  puesto_oficial String   @db.VarChar(150)
  nivel_puesto   String   @db.VarChar(40)
  empleo         empleo[]
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model catalogo_salario {
  id_salario           Int              @id @default(autoincrement()) @db.UnsignedInt
  descripcion_original String           @unique(map: "uq_desc_salario") @db.VarChar(200)
  rango_estandar       String           @db.VarChar(80)
  rango_min_soles      Decimal?         @db.Decimal(10, 2)
  rango_max_soles      Decimal?         @db.Decimal(10, 2)
  encuesta_anual       encuesta_anual[]
