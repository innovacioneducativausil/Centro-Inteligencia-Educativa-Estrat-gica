  encuesta_anual  encuesta_anual   @relation(fields: [id_encuesta], references: [id_encuesta], onDelete: NoAction, onUpdate: NoAction, map: "fk_empleo_encuesta")
  catalogo_puesto catalogo_puesto? @relation(fields: [id_puesto], references: [id_puesto], onDelete: NoAction, onUpdate: NoAction, map: "fk_empleo_puesto")

  @@index([id_puesto], map: "fk_empleo_puesto")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model encuesta_anual {
  id_encuesta       Int               @id @default(autoincrement()) @db.UnsignedInt
  id_egresado       Int               @db.UnsignedInt
  anio_encuesta     Int               @db.SmallInt
  trimestre         String            @default("Q4") @db.VarChar(5)
  situacion_laboral String?           @db.Text
  trabaja           Boolean?
  es_emprendedor    Boolean?
  afinidad_laboral  String?           @db.VarChar(10)
  nivel_puesto      String?           @db.VarChar(40)
  id_salario        Int?              @db.UnsignedInt
  satisfaccion_usil String?           @db.VarChar(40)
  encuestado        Boolean           @default(true)
  fuente_carga      String?           @db.VarChar(50)
  created_at        DateTime?         @default(now()) @db.Timestamp(0)
  empleo            empleo?
  egresado          egresado          @relation(fields: [id_egresado], references: [id_egresado], onDelete: NoAction, onUpdate: NoAction, map: "fk_encuesta_egresado")
  catalogo_salario  catalogo_salario? @relation(fields: [id_salario], references: [id_salario], onDelete: NoAction, onUpdate: NoAction, map: "fk_encuesta_salario")

  @@unique([id_egresado, anio_encuesta, trimestre], map: "uq_encuesta")
  @@index([id_salario], map: "fk_encuesta_salario")
  @@index([anio_encuesta, trimestre], map: "idx_anio_trimestre")
  @@index([id_egresado, anio_encuesta], map: "idx_egresado_anio")
  @@index([trabaja], map: "idx_trabaja")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model facultad {
