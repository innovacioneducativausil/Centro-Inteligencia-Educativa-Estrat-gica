  nombre_facultad String    @unique(map: "uq_facultad") @db.VarChar(150)
  created_at      DateTime? @default(now()) @db.Timestamp(0)
  carrera         carrera[]
}

model informe_empleabilidad {
  id             Int                                @id @default(autoincrement())
