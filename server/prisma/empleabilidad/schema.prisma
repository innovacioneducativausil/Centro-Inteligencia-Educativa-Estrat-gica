model mercado_habilidad_categoria {
  id_categoria           Int                      @id @default(autoincrement()) @db.UnsignedInt
  id_informe             Int                      @db.UnsignedInt
  orden                  Int                      @db.UnsignedTinyInt
  categoria              String                   @db.VarChar(180)
  origen_datos           String                   @default("curado") @db.VarChar(40)
  mercado_informe        mercado_informe          @relation(fields: [id_informe], references: [id_informe], onDelete: Cascade, onUpdate: NoAction, map: "fk_mercado_habcat_informe")
  mercado_habilidad_item mercado_habilidad_item[]

  @@unique([id_informe, orden], map: "uq_mercado_hab_categoria")
}

model mercado_habilidad_item {
  id_habilidad                Int                         @id @default(autoincrement()) @db.UnsignedInt
  id_categoria                Int                         @db.UnsignedInt
  orden                       Int                         @db.UnsignedTinyInt
  habilidad                   String                      @db.VarChar(220)
  mercado_habilidad_categoria mercado_habilidad_categoria @relation(fields: [id_categoria], references: [id_categoria], onDelete: Cascade, onUpdate: NoAction, map: "fk_mercado_habilidad_categoria")

  @@unique([id_categoria, orden], map: "uq_mercado_habilidad")
}

model mercado_herramienta {
  id_herramienta  Int             @id @default(autoincrement()) @db.UnsignedInt
  id_informe      Int             @db.UnsignedInt
  orden           Int             @db.UnsignedTinyInt
  nombre          String          @db.VarChar(180)
  descripcion     String?         @db.Text
  origen_datos    String          @default("curado") @db.VarChar(40)
  mercado_informe mercado_informe @relation(fields: [id_informe], references: [id_informe], onDelete: Cascade, onUpdate: NoAction, map: "fk_mercado_herramienta_informe")

  @@unique([id_informe, orden], map: "uq_mercado_herramienta")
}

model mercado_informe {
  id_informe                  Int                           @id @default(autoincrement()) @db.UnsignedInt
  id_carrera                  Int?                          @db.UnsignedInt
  nombre_facultad             String                        @db.VarChar(180)
  nombre_carrera              String                        @db.VarChar(200)
  periodo                     String                        @db.VarChar(80)
  titulo_header               String?                       @db.VarChar(220)
  descripcion_header          String?                       @db.Text
  insight_header              String?                       @db.Text
  descripcion                 String?                       @db.Text
  objetivo_final              String?                       @db.Text
  documento_informe_url       String?                       @db.VarChar(500)
  fuente                      String                        @default("Seed ZIP informes mercado laboral") @db.VarChar(160)
  origen_datos                String                        @default("semilla") @db.VarChar(40)
  activo                      Boolean                       @default(true)
  created_at                  DateTime?                     @default(now()) @db.Timestamp(0)
  updated_at                  DateTime?                     @default(now()) @db.Timestamp(0)
  mercado_habilidad_categoria mercado_habilidad_categoria[]
  mercado_herramienta         mercado_herramienta[]
  mercado_puesto_top          mercado_puesto_top[]
  mercado_recomendacion       mercado_recomendacion[]
  mercado_tendencia           mercado_tendencia[]

  @@unique([nombre_carrera, periodo], map: "uq_mercado_informe")
  @@index([nombre_carrera], map: "idx_mercado_carrera")
  @@index([nombre_facultad], map: "idx_mercado_facultad")
}

model mercado_metodologia {
  id_metodologia Int     @id @default(autoincrement()) @db.UnsignedInt
  orden          Int     @unique(map: "uq_mercado_metodologia_orden") @db.UnsignedTinyInt
  titulo         String  @db.VarChar(160)
  descripcion    String? @db.Text
