  benchmark_source_snapshot     benchmark_source_snapshot[]
  competencia_benchmark         competencia_benchmark[]
  curso_benchmark               curso_benchmark[]
  universidad_benchmark         universidad_benchmark                @relation(fields: [id_universidad_benchmark], references: [id_universidad_benchmark], onDelete: Cascade, onUpdate: NoAction, map: "fk_pb_univ")

  @@index([id_universidad_benchmark], map: "idx_pb_univ")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model tipo_programa {
  id_tipo_programa Int       @id @default(autoincrement()) @db.UnsignedInt
  descripcion      String    @unique(map: "uq_tipo_programa") @db.VarChar(80)
  carrera          carrera[]
}

model universidad_benchmark {
  id_universidad_benchmark Int                                  @id @default(autoincrement()) @db.UnsignedInt
  nombre_universidad       String                               @db.VarChar(220)
  pais                     String                               @default("Peru") @db.VarChar(100)
  ciudad                   String?                              @db.VarChar(120)
  tipo_benchmark           universidad_benchmark_tipo_benchmark
  sitio_web                String?                              @db.VarChar(500)
  activo                   Boolean                              @default(true)
  created_at               DateTime?                            @default(now()) @db.Timestamp(0)
  updated_at               DateTime?                            @default(now()) @db.Timestamp(0)
  programa_benchmark       programa_benchmark[]

  @@index([tipo_benchmark], map: "idx_tipo_benchmark")
}

