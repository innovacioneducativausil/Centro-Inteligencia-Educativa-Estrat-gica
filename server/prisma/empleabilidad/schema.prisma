  anio_egreso      Int        @db.SmallInt
  periodo_egreso   String?    @db.VarChar(50)
  estado_academico String?    @db.VarChar(60)
  estado           String?    @db.VarChar(40)
  egresado         egresado[]
}

model competencia_benchmark {
  id_competencia_benchmark Int                                    @id @default(autoincrement()) @db.UnsignedInt
  id_programa_benchmark    Int                                    @db.UnsignedInt
  nombre_competencia       String                                 @db.VarChar(300)
  descripcion_competencia  String?                                @db.Text
  tipo_competencia         competencia_benchmark_tipo_competencia @default(otro)
  evidencia_textual        String?                                @db.Text
  fuente_url               String?                                @db.VarChar(1000)
  created_at               DateTime?                              @default(now()) @db.Timestamp(0)
  updated_at               DateTime?                              @default(now()) @db.Timestamp(0)
  programa_benchmark       programa_benchmark                     @relation(fields: [id_programa_benchmark], references: [id_programa_benchmark], onDelete: Cascade, onUpdate: NoAction, map: "fk_compb_prog")

  @@index([id_programa_benchmark], map: "idx_compb_prog")
}

model curso_benchmark {
  id_curso_benchmark           Int                @id @default(autoincrement()) @db.UnsignedInt
  id_programa_benchmark        Int                @db.UnsignedInt
  nombre_curso                 String             @db.VarChar(300)
  ciclo                        String?            @db.VarChar(50)
  area_formacion               String?            @db.VarChar(180)
  descripcion_curso            String?            @db.Text
  competencias_detectadas_json Json?
  tecnologias_detectadas_json  Json?
  fuente_url                   String?            @db.VarChar(1000)
  created_at                   DateTime?          @default(now()) @db.Timestamp(0)
  updated_at                   DateTime?          @default(now()) @db.Timestamp(0)
  programa_benchmark           programa_benchmark @relation(fields: [id_programa_benchmark], references: [id_programa_benchmark], onDelete: Cascade, onUpdate: NoAction, map: "fk_cb_prog")

  @@index([id_programa_benchmark], map: "idx_cb_prog")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model egresado {
  id_egresado          Int              @id @default(autoincrement()) @db.UnsignedInt
  tipo_doc             String           @default("DNI") @db.VarChar(20)
  nro_doc              String           @db.VarChar(20)
  apellidos_nombres    String           @db.VarChar(200)
  sexo                 String?          @db.Char(1)
  correo_institucional String?          @db.VarChar(150)
  correo_personal      String?          @db.VarChar(150)
  telefono_1           String?          @db.VarChar(20)
  telefono_2           String?          @db.VarChar(20)
  becario              Boolean          @default(false)
  doble_grado          Boolean          @default(false)
  intercambio          Boolean          @default(false)
  id_carrera           Int              @db.UnsignedInt
  id_ciclo_egreso      Int              @db.UnsignedInt
  periodo_ingreso      String?          @db.VarChar(100)
  created_at           DateTime?        @default(now()) @db.Timestamp(0)
  updated_at           DateTime?        @default(now()) @db.Timestamp(0)
  carrera              carrera          @relation(fields: [id_carrera], references: [id_carrera], onDelete: NoAction, onUpdate: NoAction, map: "fk_egresado_carrera")
  ciclo_egreso         ciclo_egreso     @relation(fields: [id_ciclo_egreso], references: [id_ciclo_egreso], onDelete: NoAction, onUpdate: NoAction, map: "fk_egresado_ciclo")
  encuesta_anual       encuesta_anual[]

  @@unique([tipo_doc, nro_doc], map: "uq_egresado_doc")
  @@index([id_carrera], map: "idx_carrera")
  @@index([id_ciclo_egreso], map: "idx_ciclo")
  @@index([nro_doc], map: "idx_nro_doc")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model empleo {
