  @@unique([id_informe, tipo, orden], map: "uq_mercado_recomendacion")
}

model mercado_tendencia {
  id_tendencia    Int             @id @default(autoincrement()) @db.UnsignedInt
  id_informe      Int             @db.UnsignedInt
  orden           Int             @db.UnsignedTinyInt
  titulo          String          @db.VarChar(180)
  descripcion     String?         @db.Text
  origen_datos    String          @default("curado") @db.VarChar(40)
  mercado_informe mercado_informe @relation(fields: [id_informe], references: [id_informe], onDelete: Cascade, onUpdate: NoAction, map: "fk_mercado_tendencia_informe")

  @@unique([id_informe, orden], map: "uq_mercado_tendencia")
}

model programa_benchmark {
  id_programa_benchmark         Int                                  @id @default(autoincrement()) @db.UnsignedInt
  id_universidad_benchmark      Int                                  @db.UnsignedInt
  nombre_programa               String                               @db.VarChar(300)
  url_programa                  String?                              @db.VarChar(1000)
  carrera_equivalente_id        Int?                                 @db.UnsignedInt
  modalidad                     String?                              @db.VarChar(100)
  duracion                      String?                              @db.VarChar(100)
  perfil_egreso_texto           String?                              @db.MediumText
  plan_estudios_texto           String?                              @db.MediumText
  fuente_texto_original         String?                              @db.MediumText
  fecha_captura                 DateTime?                            @db.DateTime(0)
  estado_extraccion             programa_benchmark_estado_extraccion @default(pendiente)
  estado_validacion             programa_benchmark_estado_validacion @default(registrado)
  observaciones                 String?                              @db.Text
  created_at                    DateTime?                            @default(now()) @db.Timestamp(0)
  updated_at                    DateTime?                            @default(now()) @db.Timestamp(0)
  benchmark_parse_log           benchmark_parse_log[]
  benchmark_program_equivalence benchmark_program_equivalence?
  benchmark_source              benchmark_source[]
