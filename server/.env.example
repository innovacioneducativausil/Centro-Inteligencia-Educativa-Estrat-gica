# CIEE - Variables de entorno del Backend
# Copiar como .env y completar los valores reales
# NUNCA versionar el archivo .env en el repositorio

# ── Servidor ───────────────────────────────────────────────
NODE_ENV=production
API_PORT=3001

# ── Autenticacion JWT ──────────────────────────────────────
# Generar con: openssl rand -hex 64
# Rotar cada 12 meses o ante incidente de seguridad
JWT_SECRET=CAMBIAR_POR_SECRETO_SEGURO
JWT_EXPIRES=8h

# ── Base de datos principal (radar_carreras) ───────────────
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=radar_carreras

# ── Base de datos empleabilidad (empleabilidad_usil) ───────
DB_HOST_EMPL=
DB_PORT_EMPL=3306
DB_USER_EMPL=
DB_PASSWORD_EMPL=

# ── Base de datos curricular (mallas_usil) ─────────────────
DB_HOST_CURR=
DB_PORT_CURR=3306
DB_USER_CURR=
DB_PASSWORD_CURR=

# ── Proveedores de IA ──────────────────────────────────────
# Rotar cada 3 meses (las claves viajan en cada peticion externa)
# Limite gratuito HF: ~1,000 req/dia | Groq: ~14,400 req/dia
HF_API_KEY=
HF_API_KEY_METRICS=
HF_API_KEY_MAPPING=
HF_API_KEY_IMPORT=
HF_API_KEY_IMPORT2=
HF_API_KEY_IMPORT3=

GROQ_API_KEY=

# Mantener vacio si no se usa Google Gemini
GEMINI_API_KEY=

# ── CORS y URL del frontend ────────────────────────────────
CORS_ORIGINS=
APP_URL=
FRONTEND_URL=

# ── Correo electronico (OTP y alertas de scraping) ─────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Correo que recibe alertas si el scraping falla 3 veces seguidas
ALERT_EMAIL=

RESET_TOKEN_EXPIRES_MINUTES=60
