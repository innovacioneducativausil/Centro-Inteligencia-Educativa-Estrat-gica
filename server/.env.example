# Base de datos MySQL (Railway lo llena automáticamente con las variables MYSQL_*)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=radar_carreras

# Puerto del servidor Express
API_PORT=3001

# JWT — generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIAR_POR_SECRETO_SEGURO
JWT_EXPIRES=8h

# CORS — poner el dominio de Vercel (ej: https://radar.vercel.app)
CORS_ORIGINS=

# URL del frontend (para links en correos)
APP_URL=

# HuggingFace
HF_API_KEY=
HF_API_KEY_METRICS=
HF_API_KEY_MAPPING=
HF_API_KEY_IMPORT=
HF_API_KEY_IMPORT2=
HF_API_KEY_IMPORT3=

# Google Gemini
GEMINI_API_KEY=

# Groq
GROQ_API_KEY=

# SMTP (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Reset de contraseña
RESET_TOKEN_EXPIRES_MINUTES=60
